{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
